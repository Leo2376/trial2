VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
UNITS DISTANCE MICRONS 2000 ;

# Standard Cell Library - PMAT (Placement and Memory Assist Technology)
# Additional cells for placement optimization

# More AND gates with different drive strengths
MACRO AN2D6
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.6 BY 0.3 ;
  SYMMETRY X Y ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.1 0.1 0.2 ;
    END
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.2 0.1 0.3 0.2 ;
    END
  END B
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.45 0.1 0.6 0.2 ;
    END
  END Y
END AN2D6

MACRO AN2D8
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.75 BY 0.3 ;
  SYMMETRY X Y ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.1 0.1 0.2 ;
    END
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.3 0.1 0.4 0.2 ;
    END
  END B
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.6 0.1 0.75 0.2 ;
    END
  END Y
END AN2D8

MACRO AN3D2
