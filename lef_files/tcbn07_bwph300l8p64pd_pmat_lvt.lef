# OR gates with different drives
MACRO OR2D3
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.45 BY 0.3 ;
  SYMMETRY X Y ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.1 0.1 0.2 ;
    END
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.15 0.1 0.25 0.2 ;
    END
  END B
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.35 0.1 0.45 0.2 ;
    END
  END Y
END OR2D3

# More buffers
MACRO BUFFD10
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 1.8 BY 0.3 ;
  SYMMETRY X Y ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.1 0.1 0.2 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 1.7 0.1 1.8 0.2 ;
    END
  END Y
END BUFFD10

