# 3-input gates
MACRO AN3D1
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.6 BY 0.3 ;
  SYMMETRY X Y ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
