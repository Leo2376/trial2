VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
UNITS DISTANCE MICRONS 2000 ;

# Standard Cell Library - Base AT (Advanced Threshold)
# Technology: tcbn07 (7nm node), BWP300H8P64PD (Back-end), LVT (Low Vt)

# Inverter
MACRO INVX1BWP300H8P64PDLVT
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.3 BY 0.3 ;
  SYMMETRY X Y ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.1 0.1 0.2 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.2 0.1 0.3 0.2 ;
    END
  END Y
END INVX1BWP300H8P64PDLVT

