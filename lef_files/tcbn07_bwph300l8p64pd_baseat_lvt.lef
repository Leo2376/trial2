# Layers
LAYER M1
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.1 ;
  WIDTH 0.05 ;
END M1

LAYER M2
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.1 ;
  WIDTH 0.05 ;
END M2

SITE CORE
  CLASS CORE ;
  SIZE 0.3 BY 0.3 ;
  SYMMETRY X Y ;
END CORE

END LIBRARY
