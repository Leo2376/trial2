# Flip-flops
MACRO CKLNQD1BWP300H8P64PDLVT
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.6 BY 0.6 ;
  SYMMETRY X Y ;
  PIN CP
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.4 0.1 0.5 ;
    END
  END CP
  PIN E
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.2 0.1 0.3 ;
    END
  END E
  PIN TE
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.1 0.1 0.2 ;
    END
  END TE
  PIN Q
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.5 0.4 0.6 0.5 ;
    END
  END Q
END CKLNQD1BWP300H8P64PDLVT

